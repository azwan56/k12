# ==============================================================================
# Vanpower K12 国内阿里云生产环境配置 (k12.vanpower.net)
# 复制为 deploy/cn/.env 后填写实际密钥
# ==============================================================================

APP_ORIGIN=https://k12.vanpower.net
CORS_ORIGINS=https://k12.vanpower.net

# PostgreSQL
POSTGRES_DB=vanpower_k12
POSTGRES_USER=k12_app
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# 会话 JWT 密钥（至少 32 位随机字符串）
JWT_SECRET=replace-with-at-least-32-chars-random-jwt-secret

# 阿里云百炼 DashScope API（通义千问）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_PRACTICE=qwen-plus
QWEN_MODEL_MATH_CHALLENGE=qwen-max
QWEN_MODEL_FAST=qwen-flash

# 微信公众号（已认证企业服务号）
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_WEBHOOK_TOKEN=replace-with-wechat-server-token
WECHAT_TEMPLATE_ID_REPORT=
