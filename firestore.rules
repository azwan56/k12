rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: shared_vocabulary (existing live rule preserved)
    // Document ID: {docId}
    // Access: Any authenticated user can read and write.
    //
    // Collection: shared_vocabulary_batches (existing live rule preserved)
    // Document ID: {batchId}
    // Access: Any authenticated user can read and write.
    //
    // Collection: users (existing live rule preserved)
    // Document ID: {userId} (Firebase Auth UID) and nested documents
    // Access: Strictly scoped to the owning authenticated user (uid == userId).
    //
    // Collection: guardian_links
    // Document ID: {linkId} (deterministic `${parentUid}__${encodedEmail}`, <= 384 chars on create)
    // Fields:
    //   - parentUid: string (required, immutable, == request.auth.uid on create, 1..128 chars)
    //   - parentEmail: string (required, immutable, lowercase email, <= 254 chars, == authEmailLower() on create)
    //   - parentName: string (required, parent-mutable, <= 64 chars)
    //   - studentEmail: string (required, immutable, lowercase email, <= 254 chars, != parentEmail)
    //   - discordWebhookUrl: string (required, parent-mutable, "" or Discord HTTPS webhook, <= 300 chars)
    //   - createdAt: int (required, immutable, > 0)
    //   - updatedAt: int (required, mutable by parent or verified student, > 0)
    //   - studentUid: string | null (optional, omitted or null on create; student-mutable, == request.auth.uid on student update, 1..128 chars)
    //   - studentName: string (optional, student-mutable, <= 64 chars)
    //   - studentAvatarId: string (optional, student-mutable, <= 32 chars)
    //   - studentPhotoURL: string | null (optional, student-mutable, null, "", or https:// URL, <= 512 chars)
    //
    // Collection: student_progress
    // Document ID: {studentUid} (Firebase Auth UID, 1..128 chars)
    // Access: Owning verified student (read/create/update/delete); linked confirmed parent (get only).
    // Fields:
    //   - studentUid: string (required, immutable, == studentUid, 1..128 chars)
    //   - studentEmail: string (required, immutable, lowercase email <= 254 chars, == authEmailLower())
    //   - studentEmailEncoded: string (required, 3..320 chars, no '/', '\\', or whitespace)
    //   - displayName: string (required, <= 64 chars)
    //   - avatarId: string (required, enum ['google', 'owl', 'rocket', 'bot', 'cat', 'star'], <= 32 chars)
    //   - photoURL: string | null (required, null, "", or https:// URL, <= 512 chars)
    //   - grade: string (required, enum ['G6', 'G7'])
    //   - updatedAt: int (required, > 0)
    //   - lastActivityAt: int | null (required, null or > 0)
    //   - rewardsSummary: map (required, strict keys & nested dailyTasks validation)
    //   - subjectStats: map (required, keys subset of subject IDs, validated entries)
    //   - mathGeniusProfile: map | null (required, strict keys & weakCategories list <= 10)
    //   - wordsmithStats: map | null (required, strict keys, avgScore number 0..5)
    //   - humanityProgress: map | null (required, strict keys s1/s2/s3 ints 1..10)
    //
    // Subcollection: student_progress/{studentUid}/activities
    // Document ID: {activityId} (1..128 chars)
    // Access: Owning verified student (read/create/update/delete); linked confirmed parent (read: get & list).
    // Fields:
    //   - id: string (required, immutable, == activityId, 1..128 chars)
    //   - studentUid: string (required, immutable, == studentUid, 1..128 chars)
    //   - studentEmail: string (required, immutable, lowercase email <= 254 chars, == authEmailLower())
    //   - studentEmailEncoded: string (required, 3..320 chars, no '/', '\\', or whitespace)
    //   - type: string (required, enum ['practice', 'wordsmith', 'mathgenius', 'essay', 'humanity'])
    //   - subjectId: string (required, enum ['english', 'ig-math', 'shanghai-math', 'humanity', 'science'])
    //   - title: string (required, 1..160 chars)
    //   - grade: string (required, enum ['G6', 'G7'])
    //   - score: int (>= 0), maxScore: int (>= 0), accuracyPct: int (0..100)
    //   - durationSec: int | null (null or >= 0)
    //   - summary: string (<= 300), aiFeedback: string | null (<= 3000), essayContent: string | null (<= 6000)
    //   - difficulty: string | null (<= 32)
    //   - weakPoints: list (<= 10 strings <= 80 chars), questionItems: list (<= 25 items), wordItems: list (<= 25 items)
    //   - createdAt: int (required, immutable, > 0), updatedAt: int (required, > 0)
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0 &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidLowerEmail(email) {
      return email is string &&
        email.size() > 0 &&
        email.size() <= 254 &&
        email == email.lower() &&
        email.matches("^[a-z0-9._%+-]+@(?:[a-z0-9-]+\\.)+[a-z][a-z0-9-]{1,}$");
    }

    function isValidEncodedEmail(encoded) {
      return encoded is string &&
        encoded.size() >= 3 &&
        encoded.size() <= 320 &&
        !encoded.matches(".*[/\\\\\\s].*");
    }

    function isValidHttpsUrl(url, maxLen) {
      return url is string &&
        url.size() <= maxLen &&
        url.matches("^https://[A-Za-z0-9.-]+\\.[A-Za-z][A-Za-z0-9-]{1,}(?::[0-9]{1,5})?(?:/[^\\s<>\"']*)?$");
    }

    function isValidDiscordWebhookUrl(url) {
      return url is string &&
        url.size() <= 300 &&
        (
          url == "" ||
          url.matches("^https://(discord\\.com|discordapp\\.com|ptb\\.discord\\.com|canary\\.discord\\.com)/api/(?:v[0-9]+/)?webhooks/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)?(?:\\?[A-Za-z0-9_=&-]+)?$")
        );
    }

    function isValidOptionalUrlField(data, field, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        data[field] == "" ||
        isValidHttpsUrl(data[field], maxLen);
    }

    function isValidNullableUrlField(val, maxLen) {
      return val == null ||
        val == "" ||
        isValidHttpsUrl(val, maxLen);
    }

    function isValidDateYmd(val) {
      return val is string &&
        val.size() == 10 &&
        val.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    function isValidAvatar(val) {
      return val is string &&
        val.size() <= 32 &&
        val in ['google', 'owl', 'rocket', 'bot', 'cat', 'star'];
    }

    function isValidGrade(val) {
      return val is string &&
        val in ['G6', 'G7'];
    }

    function isValidSubjectId(val) {
      return val is string &&
        val in ['english', 'ig-math', 'shanghai-math', 'humanity', 'science'];
    }

    function isValidStringListMax10(arr, maxItemLen) {
      return arr is list &&
        arr.size() <= 10 &&
        (arr.size() < 1 || (arr[0] is string && arr[0].size() <= maxItemLen)) &&
        (arr.size() < 2 || (arr[1] is string && arr[1].size() <= maxItemLen)) &&
        (arr.size() < 3 || (arr[2] is string && arr[2].size() <= maxItemLen)) &&
        (arr.size() < 4 || (arr[3] is string && arr[3].size() <= maxItemLen)) &&
        (arr.size() < 5 || (arr[4] is string && arr[4].size() <= maxItemLen)) &&
        (arr.size() < 6 || (arr[5] is string && arr[5].size() <= maxItemLen)) &&
        (arr.size() < 7 || (arr[6] is string && arr[6].size() <= maxItemLen)) &&
        (arr.size() < 8 || (arr[7] is string && arr[7].size() <= maxItemLen)) &&
        (arr.size() < 9 || (arr[8] is string && arr[8].size() <= maxItemLen)) &&
        (arr.size() < 10 || (arr[9] is string && arr[9].size() <= maxItemLen));
    }

    // ===============================================================
    // Guardian Link Validators
    // ===============================================================

    function isValidGuardianLink(data) {
      return data.keys().hasOnly([
          'parentUid', 'parentEmail', 'parentName', 'studentEmail', 'discordWebhookUrl',
          'createdAt', 'updatedAt', 'studentUid', 'studentName', 'studentAvatarId', 'studentPhotoURL'
        ]) &&
        data.keys().hasAll([
          'parentUid', 'parentEmail', 'parentName', 'studentEmail', 'discordWebhookUrl',
          'createdAt', 'updatedAt'
        ]) &&
        data.parentUid is string && data.parentUid.size() > 0 && data.parentUid.size() <= 128 &&
        isValidLowerEmail(data.parentEmail) &&
        data.parentName is string && data.parentName.size() <= 64 &&
        isValidLowerEmail(data.studentEmail) &&
        data.studentEmail != data.parentEmail &&
        isValidDiscordWebhookUrl(data.discordWebhookUrl) &&
        data.createdAt is int && data.createdAt > 0 &&
        data.updatedAt is int && data.updatedAt > 0 &&
        (!('studentUid' in data) || data.studentUid == null || (data.studentUid is string && data.studentUid.size() > 0 && data.studentUid.size() <= 128)) &&
        (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 64)) &&
        (!('studentAvatarId' in data) || (data.studentAvatarId is string && data.studentAvatarId.size() <= 32)) &&
        isValidOptionalUrlField(data, 'studentPhotoURL', 512);
    }

    function isGuardianLinkParent() {
      return isAuthenticated() && resource.data.parentUid == request.auth.uid;
    }

    function isGuardianLinkStudent() {
      return hasVerifiedEmail() && resource.data.studentEmail == authEmailLower();
    }

    function isValidGuardianLinkParentUpdate() {
      return isGuardianLinkParent() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentName', 'discordWebhookUrl', 'updatedAt']) &&
        areImmutableFieldsUnchanged(['parentUid', 'parentEmail', 'studentEmail', 'createdAt']);
    }

    function isValidGuardianLinkStudentUpdate() {
      return isGuardianLinkStudent() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentUid', 'studentName', 'studentAvatarId', 'studentPhotoURL', 'updatedAt']) &&
        areImmutableFieldsUnchanged(['parentUid', 'parentEmail', 'parentName', 'studentEmail', 'discordWebhookUrl', 'createdAt']) &&
        'studentUid' in request.resource.data &&
        request.resource.data.studentUid == request.auth.uid;
    }

    function isGuardianLinkMatch(linkDoc, studentUid, studentEmail) {
      return 'parentUid' in linkDoc.data &&
        linkDoc.data.parentUid == request.auth.uid &&
        'studentEmail' in linkDoc.data &&
        linkDoc.data.studentEmail == studentEmail &&
        'studentUid' in linkDoc.data &&
        linkDoc.data.studentUid == studentUid;
    }

    function hasActiveGuardianLink(studentUid, studentEmail, studentEmailEncoded) {
      return isAuthenticated() &&
        isValidEncodedEmail(studentEmailEncoded) &&
        isValidLowerEmail(studentEmail) &&
        exists(/databases/$(database)/documents/guardian_links/$(request.auth.uid + "__" + studentEmailEncoded)) &&
        isGuardianLinkMatch(
          get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + "__" + studentEmailEncoded)),
          studentUid,
          studentEmail
        );
    }

    function hasActiveGuardianLinkForProgressDoc(progDoc, studentUid) {
      return 'studentEmailEncoded' in progDoc.data &&
        'studentEmail' in progDoc.data &&
        hasActiveGuardianLink(studentUid, progDoc.data.studentEmail, progDoc.data.studentEmailEncoded);
    }

    function hasActiveGuardianLinkViaProgress(studentUid) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/student_progress/$(studentUid)) &&
        hasActiveGuardianLinkForProgressDoc(
          get(/databases/$(database)/documents/student_progress/$(studentUid)),
          studentUid
        );
    }

    // ===============================================================
    // Student Progress Summary Validators
    // ===============================================================

    function isValidDailyTasks(tasks) {
      return tasks is map &&
        tasks.keys().hasOnly(['practice', 'wordsmith', 'challenge']) &&
        tasks.keys().hasAll(['practice', 'wordsmith', 'challenge']) &&
        tasks.practice is bool &&
        tasks.wordsmith is bool &&
        tasks.challenge is bool;
    }

    function isValidRewardsSummary(rs) {
      return rs is map &&
        rs.keys().hasOnly([
          'coins', 'xp', 'activeTitleId', 'streakCurrent', 'streakLongest',
          'lastCompletedDate', 'dailyDate', 'dailyTasks', 'dailyGoalAwarded', 'pendingRedemptionsCount'
        ]) &&
        rs.keys().hasAll([
          'coins', 'xp', 'activeTitleId', 'streakCurrent', 'streakLongest',
          'lastCompletedDate', 'dailyDate', 'dailyTasks', 'dailyGoalAwarded', 'pendingRedemptionsCount'
        ]) &&
        rs.coins is int && rs.coins >= 0 &&
        rs.xp is int && rs.xp >= 0 &&
        rs.activeTitleId is string && rs.activeTitleId.size() > 0 && rs.activeTitleId.size() <= 32 &&
        rs.streakCurrent is int && rs.streakCurrent >= 0 &&
        rs.streakLongest is int && rs.streakLongest >= 0 &&
        (rs.lastCompletedDate == null || isValidDateYmd(rs.lastCompletedDate)) &&
        isValidDateYmd(rs.dailyDate) &&
        isValidDailyTasks(rs.dailyTasks) &&
        rs.dailyGoalAwarded is bool &&
        rs.pendingRedemptionsCount is int && rs.pendingRedemptionsCount >= 0 && rs.pendingRedemptionsCount <= 1000;
    }

    function isValidSubjectStatEntry(entry) {
      return entry is map &&
        entry.keys().hasOnly(['completedCount', 'totalAccuracySum', 'avgAccuracyPct', 'lastPracticedAt', 'lastTitle']) &&
        entry.keys().hasAll(['completedCount', 'totalAccuracySum', 'avgAccuracyPct', 'lastPracticedAt', 'lastTitle']) &&
        entry.completedCount is int && entry.completedCount >= 0 &&
        entry.totalAccuracySum is int && entry.totalAccuracySum >= 0 &&
        entry.avgAccuracyPct is int && entry.avgAccuracyPct >= 0 && entry.avgAccuracyPct <= 100 &&
        entry.lastPracticedAt is int && entry.lastPracticedAt >= 0 &&
        entry.lastTitle is string && entry.lastTitle.size() <= 160;
    }

    function isValidSubjectStatsMap(stats) {
      return stats is map &&
        stats.keys().hasOnly(['english', 'ig-math', 'shanghai-math', 'humanity', 'science']) &&
        (!('english' in stats) || isValidSubjectStatEntry(stats['english'])) &&
        (!('ig-math' in stats) || isValidSubjectStatEntry(stats['ig-math'])) &&
        (!('shanghai-math' in stats) || isValidSubjectStatEntry(stats['shanghai-math'])) &&
        (!('humanity' in stats) || isValidSubjectStatEntry(stats['humanity'])) &&
        (!('science' in stats) || isValidSubjectStatEntry(stats['science']));
    }

    function isValidMathGeniusProfile(mg) {
      return mg == null || (
        mg is map &&
        mg.keys().hasOnly(['currentDifficulty', 'totalQuizzesTaken', 'weakCategories']) &&
        mg.keys().hasAll(['currentDifficulty', 'totalQuizzesTaken', 'weakCategories']) &&
        mg.currentDifficulty is string && mg.currentDifficulty.size() > 0 && mg.currentDifficulty.size() <= 32 &&
        mg.totalQuizzesTaken is int && mg.totalQuizzesTaken >= 0 &&
        isValidStringListMax10(mg.weakCategories, 64)
      );
    }

    function isValidWordsmithStats(ws) {
      return ws == null || (
        ws is map &&
        ws.keys().hasOnly(['totalSessions', 'totalWords', 'avgScore']) &&
        ws.keys().hasAll(['totalSessions', 'totalWords', 'avgScore']) &&
        ws.totalSessions is int && ws.totalSessions >= 0 &&
        ws.totalWords is int && ws.totalWords >= 0 &&
        ws.avgScore is number && ws.avgScore >= 0 && ws.avgScore <= 5
      );
    }

    function isValidHumanityProgress(hp) {
      return hp == null || (
        hp is map &&
        hp.keys().hasOnly(['s1', 's2', 's3']) &&
        hp.keys().hasAll(['s1', 's2', 's3']) &&
        hp.s1 is int && hp.s1 >= 1 && hp.s1 <= 10 &&
        hp.s2 is int && hp.s2 >= 1 && hp.s2 <= 10 &&
        hp.s3 is int && hp.s3 >= 1 && hp.s3 <= 10
      );
    }

    function isValidStudentProgress(studentUid, data) {
      return data.keys().hasOnly([
          'studentUid', 'studentEmail', 'studentEmailEncoded', 'displayName',
          'avatarId', 'photoURL', 'grade', 'updatedAt', 'lastActivityAt',
          'rewardsSummary', 'subjectStats', 'mathGeniusProfile', 'wordsmithStats', 'humanityProgress'
        ]) &&
        data.keys().hasAll([
          'studentUid', 'studentEmail', 'studentEmailEncoded', 'displayName',
          'avatarId', 'photoURL', 'grade', 'updatedAt', 'lastActivityAt',
          'rewardsSummary', 'subjectStats', 'mathGeniusProfile', 'wordsmithStats', 'humanityProgress'
        ]) &&
        data.studentUid is string && data.studentUid == studentUid &&
        data.studentUid.size() > 0 && data.studentUid.size() <= 128 &&
        isValidLowerEmail(data.studentEmail) &&
        isValidEncodedEmail(data.studentEmailEncoded) &&
        data.displayName is string && data.displayName.size() <= 64 &&
        isValidAvatar(data.avatarId) &&
        isValidNullableUrlField(data.photoURL, 512) &&
        isValidGrade(data.grade) &&
        data.updatedAt is int && data.updatedAt > 0 &&
        (data.lastActivityAt == null || (data.lastActivityAt is int && data.lastActivityAt > 0)) &&
        isValidRewardsSummary(data.rewardsSummary) &&
        isValidSubjectStatsMap(data.subjectStats) &&
        isValidMathGeniusProfile(data.mathGeniusProfile) &&
        isValidWordsmithStats(data.wordsmithStats) &&
        isValidHumanityProgress(data.humanityProgress);
    }

    // ===============================================================
    // Student Activity Validators
    // ===============================================================

    function isValidQuestionReviewItem(item) {
      return item is map &&
        item.keys().hasOnly(['question', 'userAnswer', 'correctAnswer', 'isCorrect', 'attempts', 'usedHint', 'category']) &&
        item.keys().hasAll(['question', 'userAnswer', 'correctAnswer', 'isCorrect']) &&
        item.question is string && item.question.size() > 0 && item.question.size() <= 600 &&
        item.userAnswer is string && item.userAnswer.size() <= 300 &&
        item.correctAnswer is string && item.correctAnswer.size() <= 300 &&
        item.isCorrect is bool &&
        (!('attempts' in item) || item.attempts == null || (item.attempts is int && item.attempts >= 0)) &&
        (!('usedHint' in item) || item.usedHint == null || item.usedHint is bool) &&
        (!('category' in item) || item.category == null || (item.category is string && item.category.size() <= 80));
    }

    function isValidWordsmithReviewItem(item) {
      return item is map &&
        item.keys().hasOnly(['word', 'partOfSpeech', 'userSentence', 'score', 'feedback', 'correction', 'isFallback']) &&
        item.keys().hasAll(['word', 'userSentence', 'score', 'feedback']) &&
        item.word is string && item.word.size() > 0 && item.word.size() <= 60 &&
        item.userSentence is string && item.userSentence.size() <= 500 &&
        item.score is number && item.score >= 0 && item.score <= 5 &&
        item.feedback is string && item.feedback.size() <= 800 &&
        (!('partOfSpeech' in item) || item.partOfSpeech == null || (item.partOfSpeech is string && item.partOfSpeech.size() <= 32)) &&
        (!('correction' in item) || item.correction == null || (item.correction is string && item.correction.size() <= 500)) &&
        (!('isFallback' in item) || item.isFallback == null || item.isFallback is bool);
    }

    function isValidQuestionItems(items) {
      return items is list &&
        items.size() <= 25 &&
        (items.size() < 1 || isValidQuestionReviewItem(items[0])) &&
        (items.size() < 2 || isValidQuestionReviewItem(items[1])) &&
        (items.size() < 3 || isValidQuestionReviewItem(items[2])) &&
        (items.size() < 4 || isValidQuestionReviewItem(items[3])) &&
        (items.size() < 5 || isValidQuestionReviewItem(items[4])) &&
        (items.size() < 6 || isValidQuestionReviewItem(items[5])) &&
        (items.size() < 7 || isValidQuestionReviewItem(items[6])) &&
        (items.size() < 8 || isValidQuestionReviewItem(items[7])) &&
        (items.size() < 9 || isValidQuestionReviewItem(items[8])) &&
        (items.size() < 10 || isValidQuestionReviewItem(items[9])) &&
        (items.size() < 11 || isValidQuestionReviewItem(items[10])) &&
        (items.size() < 12 || isValidQuestionReviewItem(items[11])) &&
        (items.size() < 13 || isValidQuestionReviewItem(items[12])) &&
        (items.size() < 14 || isValidQuestionReviewItem(items[13])) &&
        (items.size() < 15 || isValidQuestionReviewItem(items[14])) &&
        (items.size() < 16 || isValidQuestionReviewItem(items[15])) &&
        (items.size() < 17 || isValidQuestionReviewItem(items[16])) &&
        (items.size() < 18 || isValidQuestionReviewItem(items[17])) &&
        (items.size() < 19 || isValidQuestionReviewItem(items[18])) &&
        (items.size() < 20 || isValidQuestionReviewItem(items[19])) &&
        (items.size() < 21 || isValidQuestionReviewItem(items[20])) &&
        (items.size() < 22 || isValidQuestionReviewItem(items[21])) &&
        (items.size() < 23 || isValidQuestionReviewItem(items[22])) &&
        (items.size() < 24 || isValidQuestionReviewItem(items[23])) &&
        (items.size() < 25 || isValidQuestionReviewItem(items[24]));
    }

    function isValidWordItems(items) {
      return items is list &&
        items.size() <= 25 &&
        (items.size() < 1 || isValidWordsmithReviewItem(items[0])) &&
        (items.size() < 2 || isValidWordsmithReviewItem(items[1])) &&
        (items.size() < 3 || isValidWordsmithReviewItem(items[2])) &&
        (items.size() < 4 || isValidWordsmithReviewItem(items[3])) &&
        (items.size() < 5 || isValidWordsmithReviewItem(items[4])) &&
        (items.size() < 6 || isValidWordsmithReviewItem(items[5])) &&
        (items.size() < 7 || isValidWordsmithReviewItem(items[6])) &&
        (items.size() < 8 || isValidWordsmithReviewItem(items[7])) &&
        (items.size() < 9 || isValidWordsmithReviewItem(items[8])) &&
        (items.size() < 10 || isValidWordsmithReviewItem(items[9])) &&
        (items.size() < 11 || isValidWordsmithReviewItem(items[10])) &&
        (items.size() < 12 || isValidWordsmithReviewItem(items[11])) &&
        (items.size() < 13 || isValidWordsmithReviewItem(items[12])) &&
        (items.size() < 14 || isValidWordsmithReviewItem(items[13])) &&
        (items.size() < 15 || isValidWordsmithReviewItem(items[14])) &&
        (items.size() < 16 || isValidWordsmithReviewItem(items[15])) &&
        (items.size() < 17 || isValidWordsmithReviewItem(items[16])) &&
        (items.size() < 18 || isValidWordsmithReviewItem(items[17])) &&
        (items.size() < 19 || isValidWordsmithReviewItem(items[18])) &&
        (items.size() < 20 || isValidWordsmithReviewItem(items[19])) &&
        (items.size() < 21 || isValidWordsmithReviewItem(items[20])) &&
        (items.size() < 22 || isValidWordsmithReviewItem(items[21])) &&
        (items.size() < 23 || isValidWordsmithReviewItem(items[22])) &&
        (items.size() < 24 || isValidWordsmithReviewItem(items[23])) &&
        (items.size() < 25 || isValidWordsmithReviewItem(items[24]));
    }

    function isValidStudentActivity(studentUid, activityId, data) {
      return data.keys().hasOnly([
          'id', 'studentUid', 'studentEmail', 'studentEmailEncoded',
          'type', 'subjectId', 'title', 'grade',
          'score', 'maxScore', 'accuracyPct', 'durationSec',
          'summary', 'aiFeedback', 'essayContent', 'difficulty',
          'weakPoints', 'questionItems', 'wordItems', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'id', 'studentUid', 'studentEmail', 'studentEmailEncoded',
          'type', 'subjectId', 'title', 'grade',
          'score', 'maxScore', 'accuracyPct', 'durationSec',
          'summary', 'aiFeedback', 'essayContent', 'difficulty',
          'weakPoints', 'questionItems', 'wordItems', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id == activityId &&
        data.id.size() > 0 && data.id.size() <= 128 &&
        data.studentUid is string && data.studentUid == studentUid &&
        data.studentUid.size() > 0 && data.studentUid.size() <= 128 &&
        isValidLowerEmail(data.studentEmail) &&
        isValidEncodedEmail(data.studentEmailEncoded) &&
        data.type is string && data.type in ['practice', 'wordsmith', 'mathgenius', 'essay', 'humanity'] &&
        isValidSubjectId(data.subjectId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
        isValidGrade(data.grade) &&
        data.score is int && data.score >= 0 &&
        data.maxScore is int && data.maxScore >= 0 &&
        data.accuracyPct is int && data.accuracyPct >= 0 && data.accuracyPct <= 100 &&
        (data.durationSec == null || (data.durationSec is int && data.durationSec >= 0)) &&
        data.summary is string && data.summary.size() <= 300 &&
        (data.aiFeedback == null || (data.aiFeedback is string && data.aiFeedback.size() <= 3000)) &&
        (data.essayContent == null || (data.essayContent is string && data.essayContent.size() <= 6000)) &&
        (data.difficulty == null || (data.difficulty is string && data.difficulty.size() <= 32)) &&
        isValidStringListMax10(data.weakPoints, 80) &&
        isValidQuestionItems(data.questionItems) &&
        isValidWordItems(data.wordItems) &&
        data.createdAt is int && data.createdAt > 0 &&
        data.updatedAt is int && data.updatedAt > 0;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /shared_vocabulary/{docId} {
      allow read, write: if request.auth != null;
    }

    match /shared_vocabulary_batches/{batchId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /guardian_links/{linkId} {
      allow read: if isGuardianLinkParent() || isGuardianLinkStudent();

      allow create: if hasVerifiedEmail() &&
        linkId.size() > 0 && linkId.size() <= 384 &&
        isValidGuardianLink(request.resource.data) &&
        request.resource.data.parentUid == request.auth.uid &&
        request.resource.data.parentEmail == authEmailLower() &&
        (!('studentUid' in request.resource.data) || request.resource.data.studentUid == null);

      allow update: if isValidGuardianLink(request.resource.data) &&
        (isValidGuardianLinkParentUpdate() || isValidGuardianLinkStudentUpdate());

      allow delete: if isGuardianLinkParent() || isGuardianLinkStudent();
    }

    match /student_progress/{studentUid} {
      allow get: if isOwner(studentUid) || (
        resource != null &&
        'studentEmailEncoded' in resource.data &&
        'studentEmail' in resource.data &&
        hasActiveGuardianLink(studentUid, resource.data.studentEmail, resource.data.studentEmailEncoded)
      );

      allow list: if isAuthenticated() && resource.data.studentUid == request.auth.uid;

      allow create: if isOwner(studentUid) &&
        hasVerifiedEmail() &&
        studentUid.size() > 0 && studentUid.size() <= 128 &&
        isValidStudentProgress(studentUid, request.resource.data) &&
        request.resource.data.studentEmail == authEmailLower();

      allow update: if isOwner(studentUid) &&
        hasVerifiedEmail() &&
        isValidStudentProgress(studentUid, request.resource.data) &&
        request.resource.data.studentEmail == authEmailLower() &&
        areImmutableFieldsUnchanged(['studentUid', 'studentEmail']);

      allow delete: if isOwner(studentUid);

      match /activities/{activityId} {
        allow read: if isOwner(studentUid) || hasActiveGuardianLinkViaProgress(studentUid);

        allow create: if isOwner(studentUid) &&
          hasVerifiedEmail() &&
          studentUid.size() > 0 && studentUid.size() <= 128 &&
          activityId.size() > 0 && activityId.size() <= 128 &&
          isValidStudentActivity(studentUid, activityId, request.resource.data) &&
          request.resource.data.studentEmail == authEmailLower();

        allow update: if isOwner(studentUid) &&
          hasVerifiedEmail() &&
          isValidStudentActivity(studentUid, activityId, request.resource.data) &&
          request.resource.data.studentEmail == authEmailLower() &&
          areImmutableFieldsUnchanged(['id', 'studentUid', 'studentEmail', 'createdAt']);

        allow delete: if isOwner(studentUid);
      }
    }
  }
}
