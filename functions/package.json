{
  "name": "k12-functions",
  "description": "Unified Firebase Cloud Functions for Vanpower K12",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:k12:generateMathQuestions,functions:k12:getFinalFeedback,functions:k12:evaluateWordsmithSentence,functions:k12:generateWordsmithBatch,functions:k12:generatePracticeQuestions --project vanpower-f15f9",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google/genai": "^1.39.0",
    "cors": "^2.8.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "private": true
}
